# apps/web-storefront/.env.example · public site (no secrets in NEXT_PUBLIC_*) · [P1]
NEXT_PUBLIC_API_URL=http://localhost:3000

# PC-56 STORE-1a · C4 (founder D1) — the PLATFORM bazaar's tenant: the organisation a buyer signs in to from a platform page (/login).
# A tenant store's pages sign in to THEIR tenant (/<slug>/login, or a verified storefront host). Unset → the platform sign-in says it is
# not set up (never a guessed tenant). Replaces the retired build-time NEXT_PUBLIC_TENANT_ID. Local demo: the seeded demo tenant's slug.
NEXT_PUBLIC_PLATFORM_TENANT_SLUG=demo-fpo

# PC-56 STORE-1a · C2 (founder D3) — SERVER-ONLY (never prefix with NEXT_PUBLIC_). The secret the storefront signs each buyer's address
# with (x-kv-client-ip/ts/sig); the API's STOREFRONT_CALLER_SECRET must hold the SAME value. ≥ 32 random characters; the API refuses to
# boot in production without it. Empty here = no address is forwarded (every buyer shares this server's rate-limit bucket).
STOREFRONT_CALLER_SECRET=

# PC-56 STORE-1a · C2 — '1' ONLY when exactly one trusted edge proxy / load balancer in front of the storefront OVERWRITES
# x-forwarded-for with the connecting client's address (its first hop is then the buyer). Unset/0 = no client address can be trusted
# (Next only fills x-forwarded-for when the client sent none), so none is forwarded.
STOREFRONT_TRUST_PROXY=0

# PC-56 STORE-1c · C1/C4 (founder D2) — the PLATFORM's country (two letters, ISO 3166-1): /pricing lists the public plans of this country when
# no ?country= is given; the /for-organisations form reads a bare national number by its digit rule; a self-serve organisation is created
# in it. Default IN. Not a secret.
NEXT_PUBLIC_PLATFORM_COUNTRY=IN

# The organisation console (web-tenant) origin. /for-organisations' done step links "Open your console" to <this>/login (the new owner signs
# in there again by OTP — no cross-origin token handoff). Unset → the done step says the console address is not configured.
NEXT_PUBLIC_TENANT_APP_URL=
