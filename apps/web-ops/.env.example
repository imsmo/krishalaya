# apps/web-ops/.env.example · every variable apps/web-ops/src reads (src/lib/env.ts is the only reader). Copy to .env.local.
# Only NEXT_PUBLIC_* reaches the browser bundle — never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:3000
# API_URL_INTERNAL=http://api.internal:3000  # optional in-cluster SSR origin (server-side only; falls back to NEXT_PUBLIC_API_URL)
# The tenant this console serves; in production it is derived from the host, locally set it to a seeded tenant's uuid.
NEXT_PUBLIC_TENANT_ID=
# Console visibility switches — the API's own flags + permissions stay the authoritative gates.
# AUCTIONS is shown unless exactly "false"; every other switch is shown only when exactly "true".
NEXT_PUBLIC_FEATURE_AUCTIONS=true
NEXT_PUBLIC_FEATURE_DAIRY=false
NEXT_PUBLIC_FEATURE_LABOUR=false
NEXT_PUBLIC_FEATURE_AMBASSADORS=false
NEXT_PUBLIC_FEATURE_SCHEMES=false
NEXT_PUBLIC_FEATURE_GROUP_LOTS=false
NEXT_PUBLIC_FEATURE_AUDITOR=false
NEXT_PUBLIC_FEATURE_AI_REVIEW=false
NEXT_PUBLIC_FEATURE_EDUCATION=false
NEXT_PUBLIC_FEATURE_COMMS=false
NEXT_PUBLIC_FEATURE_MEMBERSHIPS=false
NEXT_PUBLIC_FEATURE_PROMOTIONS=false
NEXT_PUBLIC_FEATURE_MARKET=false
NEXT_PUBLIC_FEATURE_INBOX=false
NEXT_PUBLIC_FEATURE_REQUIREMENTS=false
# NODE_ENV is also read (next.config.js CSP, dev-only paths) — set by next dev / next build, never here.
