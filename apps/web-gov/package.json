    "dev": "next dev -p 3007",
    "build": "next build",
    "start": "next start -p 3007",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:render": "jest -c jest.render.config.js"
  },
  "dependencies": {
    "next": "^14.2.13", "react": "^18.3.1", "react-dom": "^18.3.1",
    "@krishalaya/ui": "workspace:*", "@krishalaya/sdk-js": "workspace:*",
    "@krishalaya/i18n": "workspace:*", "@krishalaya/tokens": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.4", "@types/react": "^18.3.5", "@types/react-dom": "^18.3.0",
    "@types/node": "^20.16.10", "eslint": "^8.57.0", "eslint-config-next": "^14.2.13",
    "jest": "^29.7.0", "ts-jest": "^29.2.5", "@types/jest": "^29.5.13"
  }
}
