{
  "name": "@krishalaya/web-gov",
  "version": "0.1.0",
  "private": true,
  "description": "Government console: a person signs in to a government AUTHORITY through the API's gov realm (/v1/gov/*, PC-56 GOV-0/GOV-1a) — phone code then authenticator code; the authority's people and role requests. NEVER god-mode.",
