# apps/web-gov/.env.example · every variable apps/web-gov/src reads (src/lib/env.ts is the only reader). Copy to .env.local.
# Only NEXT_PUBLIC_* reaches the browser bundle — never put a secret here.
# PC-56 GOV-1a: the console signs into a government AUTHORITY (the gov realm) — it holds no tenant id and no feature switches; the
# platform switch `gov_console` is read from the API's public flag map.
NEXT_PUBLIC_API_URL=http://localhost:3000
# API_URL_INTERNAL=http://api.internal:3000  # optional in-cluster SSR origin (server-side only; falls back to NEXT_PUBLIC_API_URL)
# NODE_ENV is also read (next.config.js CSP, dev-only paths) — set by next dev / next build, never here.
