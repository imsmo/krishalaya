# apps/mobile/.env.example · API base URL per env via expo config; secrets never in app bundle · [P1]
EXPO_PUBLIC_API_URL=http://localhost:3000
# MOB-STORE-1 (all optional locally — unset = feature off; see docs/mobile/PUSH-SETUP.md):
# EAS_PROJECT_ID=            # from `eas init` → OTA updates.url + Expo push projectId
# EXPO_OWNER=                # Expo account/org slug
# EXPO_PUBLIC_SENTRY_DSN=    # crash reporting; unset = SDK never initialised, no network
# SENTRY_ORG= / SENTRY_PROJECT= / SENTRY_AUTH_TOKEN=   # build-time source-map upload (EAS secret; never in the bundle)
# GOOGLE_SERVICES_JSON=      # path to google-services.json (EAS file variable) → Android FCM
