{
  "name": "@krishalaya/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Farmer/Buyer/Worker/Ambassador role-switching app — offline-first, vernacular, low-end devices.",
  "main": "expo-router/entry",
  "scripts": {
    "build:deps": "pnpm --filter @krishalaya/ui-native build",
    "prestart": "pnpm run build:deps",
    "start": "expo start",
    "preandroid": "pnpm run build:deps",
    "android": "expo run:android",
    "preios": "pnpm run build:deps",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest --passWithNoTests --runInBand",
    "test:core": "jest --selectProjects core --passWithNoTests --runInBand",
    "test:render": "jest --selectProjects render --passWithNoTests --runInBand"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@expo-google-fonts/fraunces": "^0.2.3",
    "@expo-google-fonts/hind": "^0.2.3",
    "@expo-google-fonts/plus-jakarta-sans": "^0.2.3",
    "@expo/metro-runtime": "~58.0.17",
    "@krishalaya/i18n": "workspace:*",
    "@krishalaya/sdk-js": "workspace:*",
    "@krishalaya/tokens": "workspace:*",
    "@krishalaya/ui-native": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.3",
    "expo-speech-recognition": "~58.0.1",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-razorpay": "^3.0.0",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.16.10",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "babel-preset-expo": "~58.0.26",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "19.3.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
