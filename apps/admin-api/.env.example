# apps/admin-api/.env.example · admin-api bootstrap/config (own JWT issuer, own secrets kv/<env>/admin) · [P1]
#
# [DEV-56 2026-08-12] Rewritten from a one-line stub. Every variable below is read from ONE place —
# `src/core/config/admin-config.ts` (`AdminConfig`'s constructor) — grep-verified, nothing else in admin-api
# reads `process.env` directly. Marked per variable:
#   REQUIRED-HARD  = `assertProductionSecurity()` throws at boot in production if missing/weak. Locally it is
#                    NOT enforced (NODE_ENV!=production skips the check) but the app will misbehave without it.
#   REQUIRED-SOFT  = has a working default, but you almost always want to set it explicitly for real use.
#   OPTIONAL       = empty-string/false default; the dependent feature degrades or no-ops without it.
# Every value below is a PLACEHOLDER — none of these are real credentials, and none should ever look like one.
# Copy this file to `.env`, then run `openssl rand -hex 32` (or similar) for every *_SECRET before starting the app.

# ---- core ----
NODE_ENV=development                                          # REQUIRED-SOFT (default 'development'); set 'production' only with every REQUIRED-HARD var below satisfied
ADMIN_PORT=4001                                                # REQUIRED-SOFT (default 4001)

# ---- database (kv_admin: BYPASSRLS, every query audited — see db/local/local-login-roles.sql) ----
DATABASE_ADMIN_URL=postgres://kv_admin:dev@localhost:5432/krishalaya   # REQUIRED-HARD in production; falls back to DATABASE_URL if unset (dev convenience only)
DATABASE_ADMIN_POOL_MAX=10                                     # REQUIRED-SOFT (default 10) — NOTE: the actual env var read is DATABASE_ADMIN_POOL_MAX, not DATABASE_POOL_MAX (the AdminEnv interface field name differs from the env var it's populated from — read admin-config.ts before trusting the field name)

# ---- admin JWT (separate security realm from apps/api — own issuer/secret, never shared) ----
ADMIN_JWT_SECRET=eJRcHs1jasayLDy7WMxC886fw6ZXP241oaPnXjrCl-PuazIJ   # REQUIRED-HARD in production (>=32 chars, must not match /change-?me|dev-|test|secret-secret|placeholder/i)
ADMIN_JWT_ISSUER=krishalaya-admin                              # REQUIRED-SOFT (default 'krishalaya-admin')
ADMIN_JWT_AUDIENCE=krishalaya-admin-api                         # REQUIRED-SOFT (default 'krishalaya-admin-api')

# ---- admin front-door security (Law 8: fail-closed in production) ----
ADMIN_IP_ALLOWLIST=                                             # REQUIRED-HARD in production (comma-separated IPs/prefixes; empty = allow-all, refused to boot in prod). Empty is fine for local dev.
ADMIN_REQUIRE_HARDWARE_KEY=false                                # REQUIRED-HARD in production (must be true there); defaults to (NODE_ENV==='production') locally, i.e. false in dev
ADMIN_STEP_UP_MAX_AGE_SEC=900                                   # REQUIRED-SOFT (default 900 = 15 min) — sensitive ops require a re-auth this recent
ADMIN_OPERATOR_REGISTRY_ENABLED=true                            # REQUIRED-HARD in production (must be true there — suspension/session-revocation/dormancy depend on it); default true everywhere

# ---- DEV-ONLY LOGIN BYPASS (DEV-56 Part 3 — see login/page.tsx + admin-auth.ts) ----
# Mints a real HS256 admin session locally so the founder can log in without a live SSO/IdP. Gated OFF by
# default and refused outright when NODE_ENV=production (assertProductionSecurity() throws if this is ever
# true in prod, even if someone sets it by mistake — see admin-config.ts). NEVER set this to true anywhere
# but a laptop.
ADMIN_DEV_LOGIN_ENABLED=false                                   # REQUIRED-HARD-OFF in production (boot refuses if true there); OPTIONAL locally, default false

# ---- wallet-service gRPC (the ONLY money writer this realm calls — Law 2/9) ----
WALLET_GRPC_ADDR=                                               # OPTIONAL (default '') — payout/recon endpoints that need the wallet seam will error until set
WALLET_S2S_TOKEN=                                               # OPTIONAL (default '') — service-to-service bearer, never logged
WALLET_GRPC_TIMEOUT_MS=4000                                     # REQUIRED-SOFT (default 4000)

# ---- impersonation / act-as (Law 10: kill-switch, default OFF) ----
IMPERSONATION_ENABLED=false                                     # REQUIRED-SOFT (default false) — act-as is refused unless explicitly on
IMPERSONATION_TOKEN_SECRET=                                     # REQUIRED-HARD ONLY IF IMPERSONATION_ENABLED=true in production (>=32 chars); OPTIONAL otherwise. Dedicated key — never reuse ADMIN_JWT_SECRET.
IMPERSONATION_TOKEN_ISSUER=krishalaya-impersonation             # REQUIRED-SOFT (default 'krishalaya-impersonation')
IMPERSONATION_TOKEN_AUDIENCE=krishalaya-api                     # REQUIRED-SOFT (default 'krishalaya-api')
IMPERSONATION_MAX_TTL_SEC=1800                                  # REQUIRED-SOFT (default 1800 = 30 min hard cap)

# ---- object storage (PC-56 ADMIN-1c — READ-ONLY: admin-api only presigns downloads, never uploads) ----
MEDIA_BUCKET=                                                   # OPTIONAL (default '') — download-link endpoints error until set
MEDIA_REGION=ap-south-1                                         # REQUIRED-SOFT (default 'ap-south-1')
MEDIA_ACCESS_KEY_ID=                                             # OPTIONAL (default '') — dev-safe placeholder, never a real AWS key
MEDIA_SECRET_ACCESS_KEY=                                         # OPTIONAL (default '') — dev-safe placeholder, never a real AWS secret
MEDIA_ENDPOINT=                                                 # OPTIONAL (default null ⇒ AWS virtual-hosted-style; set for MinIO/LocalStack, e.g. http://localhost:9000)
MEDIA_FORCE_PATH_STYLE=false                                    # REQUIRED-SOFT (default false; set true for MinIO/LocalStack)
MEDIA_PRESIGN_EXPIRY_SEC=120                                    # REQUIRED-SOFT (default 120) — deliberately short: a download link should not survive being pasted into a chat thread
