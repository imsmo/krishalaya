# Root .dockerignore — keeps build context small + prevents shipping secrets/junk into images.
# Build context for ALL service images is the repo root (docker build -f infra/docker/<x>.Dockerfile .).
**/node_modules
**/.next
**/dist
**/.turbo
**/coverage
**/.git
.git
**/.env
**/.env.*
!**/.env.example
**/*.log
**/.DS_Store
**/__tests__
**/*.spec.ts
**/*.test.ts
infra/terraform/**/.terraform
**/*.tfstate*
docs
**/*.md
apps/mobile
# MOB-SDK-1: mobile-only (React Native 0.88 devDependencies) and no service imports it — kept out of every image's
# build context so images stay small. (Images run node:22-alpine since MOB-SDK-1; Node 20 is end-of-life.)
packages/ui-native
