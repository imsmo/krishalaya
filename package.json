{
  "name": "krishalaya",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "migrate": "node db/scripts/migrate.js",
    "migrate:status": "node db/scripts/migrate.js --status",
    "migrate:plan": "node db/scripts/migrate.js --plan",
    "seed": "node db/scripts/seed.js",
    "seed:demo": "node db/scripts/seed.js --demo",
    "db:reset": "node db/scripts/migrate.js && node db/scripts/seed.js",
    "db:test": "node --test db/scripts/__tests__/*.test.js",
    "db:partitions": "node db/scripts/ensure-partitions.js",
    "db:archive": "node db/scripts/archive-partitions.js",
    "db:verify-rls": "node db/scripts/verify-rls-coverage.js",
    "db:slow": "node db/scripts/explain-top-queries.js",
    "i18n:detect-strings": "node tools/scripts/i18n/detect-hardcoded-strings.js",
    "i18n:detect-strings:json": "node tools/scripts/i18n/detect-hardcoded-strings.js --json",
    "i18n:check-font-budget": "node tools/scripts/i18n/check-font-budget.js",
    "i18n:check-rtl-logical": "node tools/scripts/i18n/check-rtl-logical-properties.js",
    "i18n:test-scripts": "node --test tools/scripts/i18n/__tests__/*.test.js",
    "ui:adoption-report": "node tools/scripts/ui-adoption-report.js",
    "ui:adoption-report:json": "node tools/scripts/ui-adoption-report.js --json"
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript-eslint": "^7.18.0"
  },
  "pnpm": {
    "overrides": {
      "@expo/config-plugins": "8.0.11"
    }
  }
}
